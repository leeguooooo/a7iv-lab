# Keep device data and third-party checkouts outside source control by default.
/*
!/.gitignore
!/README.md
!/README_WORKFLOW.md
!/UPSTREAMS.md
!/requirements-analysis.txt
!/camera-workflow
!/*.py
!/native/
/native/*
!/native/*.c
!/native/*.h
!/native/*.md
!/tools/
/tools/*
!/tools/*.py
!/tools/*.c
!/tests/
/tests/*
!/tests/*.py
!/.github/
!/.github/workflows/
!/.github/workflows/source-checks.yml
__pycache__/
*.pyc
*.pem
*.key
*.bin
*.img
*.dat
*.DAT
*.so
*.dylib
*.o
*.elf
